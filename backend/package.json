{
  "name": "brewski-bets-backend",
  "version": "1.14.2",
  "description": "Backend API for brewski bets",
  "author": "Michal Wiraszka",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "tunnel": "ngrok http 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**' 'api/**'",
    "format": "prettier --write 'src/**/*.ts' 'api/**/*.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@clerk/backend": "3.28.0",
    "@hono/node-server": "2.1.8",
    "@hono/zod-validator": "0.9.1",
    "@neondatabase/serverless": "1.2.0",
    "@sentry/node": "11.12.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "svix": "2.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "brace-expansion@^1.1.7": "1.1.16",
      "brace-expansion@^2.0.2": "2.1.7",
      "brace-expansion@^5.0.2": "5.0.12",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "lodash-es": ">=4.18.0",
      "js-cookie": ">=3.0.7",
      "minimatch@<11.0.1": "^11.0.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react"
      ]
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild"
    ]
  }
}
