      "piscina": ">=5.3.2",
      "tar": ">=7.5.21",
      "js-yaml": ">=4.3.0",
      "@babel/core": "7.29.7",
      "fast-uri": ">=4.2.3 <5",
      "immutable": ">=5.1.8",
      "body-parser": ">=2.3.0",
      "hono": ">=4.12.32",
