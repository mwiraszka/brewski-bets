{
  "name": "brewski-bets",
  "version": "1.14.1",
  "description": "Frontend for brewski bets, built with Angular",
  "author": "Michal Wiraszka",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/brewski-bets.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:prod": "ng serve -o --configuration production",
    "build:dev": "ng build",
    "build:preview": "ng build --configuration preview",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --stats-json && webpack-bundle-analyzer dist/stats.json",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write 'src/**/*.{ts,html,scss}'",
    "lint": "eslint 'src/**'",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@clerk/clerk-js": "6.41.0",
    "@eagami/ui": "5.76.0",
    "chart.js": "4.6.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
